# ExamSys server configuration. Copy to `.env` (never commit real secrets).
#
# Development defaults live in src/config/env.ts; anything marked "required in
# production" must be provided through the environment there.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=ExamSys
DATABASE_FILE=../data/examsys.sqlite
SERVE_WEB=true

# --- secrets (generate per environment, rotate on exposure) ------------------
# Required in production (>= 32 characters). Session, CSRF and password-reset tokens are
# stored as HMACs keyed with SESSION_SECRET, so changing it invalidates every live session.
# JWT_SECRET=
# SESSION_SECRET=

# --- boot provisioning --------------------------------------------------------
# On an empty database the server applies migrations, creates the RBAC catalogue and the
# first platform administrator, and (outside production, unless disabled) seeds the
# labelled demo data, so a re-created data directory comes back usable.
# SEED_DEMO_DATA=false

# --- sessions and sign-in ----------------------------------------------------
SESSION_TTL_HOURS=12
# Cookie attributes are derived from the request transport by default:
#   plain HTTP  -> Secure=false, SameSite=Lax   (Secure cookies are dropped on http)
#   HTTPS/proxy -> Secure=true,  SameSite=None  (required for embedded/iframe clients)
# Set these only to force a specific policy; they override the automatic choice.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=10
# Allow the SPA to receive its session token in the login response and use
# `Authorization: Bearer`. Needed only where cookies are blocked (embedded/iframe
# clients); defaults to on outside production.
# ALLOW_SESSION_TOKENS=false

# --- examination timing -------------------------------------------------------
ATTEMPT_CLOCK_GRACE_SECONDS=20
SCHEDULER_ENABLED=true

# --- platform administrator (first boot only) --------------------------------
# PLATFORM_ADMIN_EMAIL=admin@example.org
# PLATFORM_ADMIN_PASSWORD=

# --- demo data -----------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo-Password1
# Expose password-reset tokens in API responses (development only).
# EXPOSE_RESET_TOKENS=false

# --- transport ------------------------------------------------------------------
TRUST_PROXY=false
# CORS_ORIGINS=https://app.example.org
